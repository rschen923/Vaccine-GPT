{
  "download_root": "data/raw",
  "metadata_root": "data/metadata",
  "user_agent": "VaccineGPT-data-pipeline/0.1 (research; contact: configure-email)",
  "sources": [
    {
      "name": "ncbi_refseq_bacteria",
      "kind": "ncbi_datasets",
      "enabled": true,
      "query": "taxon bacteria",
      "include": ["genome", "protein", "gff3"],
      "output": "ncbi_refseq_bacteria.zip",
      "required_external": "datasets"
    },
    {
      "name": "uniprot_bacteria_reviewed",
      "kind": "http",
      "enabled": true,
      "url": "https://rest.uniprot.org/uniprotkb/stream?format=tsv&query=%28taxonomy_id%3A2%29%20AND%20%28reviewed%3Atrue%29",
      "output": "uniprot_bacteria_reviewed.tsv"
    },
    {
      "name": "string_links",
      "kind": "http",
      "enabled": false,
      "url": "https://stringdb-downloads.org/download/protein.links.v12.0/9606.protein.links.v12.0.txt.gz",
      "output": "string_links.txt.gz",
      "note": "Set organism-specific taxon and the licensed/current STRING release before enabling."
    },
    {
      "name": "iedb_mhc_ii",
      "kind": "http",
      "enabled": false,
      "url": "https://www.iedb.org/database_export_v3.php",
      "output": "iedb_export.dat",
      "note": "Confirm current IEDB export endpoint and terms before enabling."
    },
    {
      "name": "vfdb",
      "kind": "manual",
      "enabled": false,
      "url": "http://www.mgc.ac.cn/VFs/",
      "output": "vfdb_download_required.txt",
      "note": "VFDB distribution path/version must be confirmed from the current release page."
    },
    {
      "name": "oge_e_or_deg",
      "kind": "manual",
      "enabled": false,
      "url": "https://v3.ogee.info",
      "output": "essentiality_download_required.txt",
      "note": "Export requires selecting the desired organisms and tables."
    }
  ]
}
