{
  "protein": {
    "backend": "esm3",
    "config": {
      "model_id": "esm3-sm-open-v1",
      "device": "auto",
      "dtype": "float32",
      "freeze": true,
      "unfreeze_last_n_layers": 0,
      "extra": {"max_length": 256, "embedding_dimension": 1536}
    },
    "role": "primary frozen protein sequence representation; not a classifier"
  },
  "dna_v2_evo2": {
    "backend": "evo2",
    "config": {
      "model_id": "evo2_7b",
      "device": "auto",
      "dtype": "bfloat16",
      "freeze": true,
      "extra": {"layer_name": "blocks.28.mlp.l3"}
    },
    "role": "v2 DNA windows only; use supported Linux/WSL2 CUDA runtime"
  },
  "dna_v2_dnabert2_baseline": {
    "backend": "dnabert2",
    "config": {
      "model_id": "zhihan1996/DNABERT-2-117M",
      "device": "auto",
      "dtype": "float32",
      "freeze": true,
      "trust_remote_code": true,
      "extra": {"max_length": 512}
    },
    "role": "optional v2 baseline; not part of v1 protein input"
  },
  "rna_fm_optional": {
    "backend": "rna_fm",
    "config": {
      "model_id": "rna_fm_t12",
      "device": "auto",
      "dtype": "float32",
      "freeze": true
    },
    "role": "optional ncRNA feature provider; outside the v1 primary input contract"
  }
}
