{
  "schema_version": "vaccinegpt-pretrained-models-1.0",
  "v1": {
    "primary_protein_adapter": "protein_esm3",
    "adapters": {
      "protein_esm3": {
        "backend": "esm3",
        "model_id": "esm3-sm-open-v1",
        "source": "https://github.com/Biohub/esm",
        "frozen": true,
        "max_length": 256,
        "output_dimension": 1536,
        "role": "primary_protein_representation",
        "runtime_status": "separate_optional_environment"
      }
    }
  },
  "v2": {
    "adapters": {
      "dna_evo2": {
        "backend": "evo2",
        "model_id": "evo2_7b",
        "source": "https://github.com/ArcInstitute/evo2",
        "layer_name": "blocks.28.mlp.l3",
        "frozen": true,
        "role": "optional DNA-window encoder",
        "runtime_status": "Linux_or_WSL2_CUDA_only_not_installed"
      }
    }
  },
  "policy": {
    "v1_rejects_dna_as_primary_input": true,
    "esm3_is_primary_v1_protein_backbone": true,
    "esm2_is_retained_only_for_upstream_clef_checkpoint_compatibility": true,
    "checkpoint_revision_and_sha256_required_before_claimed_inference": true,
    "missing_model_weights_must_raise_not_return_random_biological_scores": true
  }
}
